    { "source": "/logbook", "destination": "/api/index" },
    { "source": "/logbook/(.*)", "destination": "/api/index" },
    { "source": "/galeri/(.*)", "destination": "/api/index" },
    { "source": "/logo/(.*)", "destination": "/api/index" },
