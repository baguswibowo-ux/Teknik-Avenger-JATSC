    { "source": "/hak-akun", "destination": "/api/index" },
    { "source": "/hak-akun/(.*)", "destination": "/api/index" },
    { "source": "/ttd-akun/(.*)", "destination": "/api/index" },
    { "source": "/cetak-antrian", "destination": "/api/index" },
    { "source": "/cetak-antrian/(.*)", "destination": "/api/index" },
