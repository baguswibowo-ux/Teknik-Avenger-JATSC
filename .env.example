# Salin jadi .env kalau perlu mengubah bawaannya.

# Port aplikasi ini. Jangan 3000 — itu milik E-Logbook.
PORT=3100

# Alamat server E-Logbook yang jadi sumber data.
# 127.0.0.1, bukan localhost: di Windows localhost bisa terselesaikan ke ::1
# lebih dulu, dan server E-Logbook belum tentu mendengarkan di IPv6.
ELOGBOOK_ASAL=http://127.0.0.1:3000

# Set 1 untuk memutus penerusan — halaman jatuh ke data contoh.
# ELOGBOOK_MATI=1

# Alamat E-Logbook untuk DIBUKA DI PERAMBAN lewat tombol "Buka E-Logbook".
# Kosongkan saja kalau E-Logbook jalan di mesin yang sama dengan dashboard ini:
# halaman merangkainya sendiri dari hostname yang sedang dipakai + port di atas.
# Isi hanya kalau alamatnya memang lain, mis. sudah di balik nama domain.
# ELOGBOOK_TAUTAN=http://elogbook.jatsc.lan
