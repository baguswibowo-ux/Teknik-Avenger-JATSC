# Salin jadi .env kalau perlu mengubah bawaannya.
#
# Semuanya sengaja dikomentari, supaya bawaannya yang berlaku.

# ---------------------------------------------------------------------------
# DI KOMPUTER SENDIRI / SERVER KANTOR
# ---------------------------------------------------------------------------

# Port aplikasi ini. Jangan 3000 — itu milik E-Logbook.
# PORT=3100

# Port E-Logbook yang dinyalakan bersama dashboard oleh `npm start`.
# ELOGBOOK_PORT=3000

# Alamat server E-Logbook yang jadi sumber data.
# 127.0.0.1, bukan localhost: di Windows localhost bisa terselesaikan ke ::1
# lebih dulu, dan server E-Logbook belum tentu mendengarkan di IPv6.
# ELOGBOOK_ASAL=http://127.0.0.1:3000

# Set 1 untuk memutus penerusan — halaman jatuh ke data contoh.
# ELOGBOOK_MATI=1

# Alamat E-Logbook untuk DIBUKA DI PERAMBAN lewat tombol "Buka E-Logbook".
#
# BIARKAN KOSONG. Bawaannya sekarang /logbook/ — E-Logbook disajikan lewat
# server ini, di dalam asal yang sama. Itulah yang membuat sesinya cuma satu:
# tombol yang menyeberang ke host lain menyeberangkan pemakainya ke toples
# cookie yang lain, dan di sana ia bisa jadi orang lain — teknisi satu unit di
# dashboard, administrator yang membuka semua unit di E-Logbook.
#
# Mengisinya mengembalikan tombol itu ke host E-Logbook yang sungguhan, berikut
# sesi yang terbelah tadi. Hanya untuk pemasangan yang memang sengaja
# memisahkan keduanya.
# ELOGBOOK_TAUTAN=http://elogbook.jatsc.lan

# DATA_CONTOH sudah tidak dibaca. Dulu 0 berarti "jangan jatuh ke data contoh
# waktu E-Logbook diam"; data contohnya sendiri sekarang tidak ada, jadi
# perilaku itu satu-satunya yang tersisa. Boleh dibiarkan terpasang di tempat
# yang sudah memilikinya.

# Set 1 untuk mematikan unggah dan hapus foto galeri.
# GALERI_MATI=1

# ---------------------------------------------------------------------------
# SERVER SENDIRI DI BALIK PROXY (Cloudflare Tunnel, nginx, dsb.) — Sep 2026
#
# Di PC sendiri kedua aplikasi dijangkau lewat cloudflared yang jalan di
# komputer yang sama. Socket lalu selalu melihat 127.0.0.1; alamat klien yang
# sebenarnya ada di X-Forwarded-For. Tanpa PROXY_TEPERCAYA semua orang tampak
# datang dari satu alamat dan penahan login E-Logbook (8 gagal / 5 menit per
# IP) jadi jatah bersama. Dibaca dashboard DAN E-Logbook (diwariskan lewat
# jalankan-semua.js).
# ---------------------------------------------------------------------------

# loopback  = percaya proxy di komputer ini saja (cloudflared/nginx lokal).
# 1         = percaya semua hop; hanya kalau port ini benar-benar tidak bisa
#             dicapai langsung dari luar. Nilai lain diteruskan ke Express.
# Kosong    = tidak ada proxy; akses langsung di LAN kantor.
# PROXY_TEPERCAYA=loopback

# Cookie sesi E-Logbook diberi atribut Secure. WAJIB begitu diakses lewat HTTPS
# (domain di balik Cloudflare). Jangan dinyalakan selama masih diuji lewat
# http://<ip-lan>: peramban akan menolak cookienya dan login tampak "tidak
# jadi". http://localhost tetap boleh — peramban menganggapnya aman.
# ELOGBOOK_SECURE_COOKIE=1

# --- Notifikasi HP (Web Push) ---
# Kunci VAPID dibuat sendiri sekali di elogbook/data/push-vapid.json. Set
# PUSH_MATI=1 untuk mematikan notifikasi HP sama sekali.
# PUSH_MATI=1
#
# Pengingat ke pembuat logbook kalau belum ditandatangani 30 menit setelah
# dinasnya berakhir — sekali per catatan, lewat notifikasi HP. Angka ini mengganti
# 30 menit itu; isi hanya waktu menguji, lalu hapus lagi.
# PENGINGAT_TTD_MENIT=30
#
# Pengingat ke tiap teknisi satu jam sebelum dinasnya mulai, dari jadwal dinas
# (data/dinas.json) — sekali per orang per dinas, lewat notifikasi HP. Dihitung
# server dashboard, dikirim lewat E-Logbook (pintu internal, loopback saja).
# Orangnya dicocokkan ke akun lewat NIK di jadwal (= username E-Logbook), nama
# hanya cadangan untuk bulan yang NIK-nya kosong. Angka ini mengganti 60 menit
# itu; isi hanya waktu menguji, lalu hapus lagi.
# PENGINGAT_DINAS_MENIT=60

# Pengingat kegiatan berkala (dashboard): sejam SESUDAH dinas mulai, tiap orang
# yang berdinas menerima daftar kegiatan berkala unitnya yang jatuh hari ini
# atau sudah lewat dan belum dikerjakan. Butuh E-Logbook versi yang punya
# /internal/bukti-berkala. Angka ini mengganti 60 menit itu; isi hanya waktu
# menguji, lalu hapus lagi.
# PENGINGAT_BERKALA_MENIT=60

# Cadangan harian (tools/cadangkan.js, dijadwalkan tools/pasang-jadwal.cmd).
# Sebaiknya drive LAIN dari drive aplikasi, atau folder yang disinkronkan ke
# cloud. Folder harian lebih tua dari CADANGAN_SIMPAN_HARI dihapus sendiri.
# CADANGAN_DIR=D:\Cadangan Avenger
# CADANGAN_SIMPAN_HARI=14
