# Salin jadi .env kalau perlu mengubah bawaannya.
#
# Semuanya sengaja dikomentari. Selain supaya bawaannya yang berlaku, ada sebab
# kedua: Vercel MEMBACA berkas ini waktu proyek baru diimpor, dan tiap baris
# yang tidak dikomentari muncul sebagai environment variable yang seakan
# disarankan. ELOGBOOK_ASAL di bawah menunjuk ke 127.0.0.1 — benar di komputer
# sendiri, dan salah total di Vercel, tempat localhost tidak berisi apa pun.

# ---------------------------------------------------------------------------
# DI KOMPUTER SENDIRI / SERVER KANTOR
# ---------------------------------------------------------------------------

# Port aplikasi ini. Jangan 3000 — itu milik E-Logbook.
# Tidak dipakai di Vercel: di sana server.js tidak pernah listen().
# PORT=3100

# Port E-Logbook yang dinyalakan bersama dashboard oleh `npm start`.
# ELOGBOOK_PORT=3000

# Alamat server E-Logbook yang jadi sumber data.
# 127.0.0.1, bukan localhost: di Windows localhost bisa terselesaikan ke ::1
# lebih dulu, dan server E-Logbook belum tentu mendengarkan di IPv6.
# Di Vercel ini WAJIB diisi alamat https E-Logbook, bukan 127.0.0.1.
# ELOGBOOK_ASAL=http://127.0.0.1:3000

# Set 1 untuk memutus penerusan — halaman jatuh ke data contoh.
# ELOGBOOK_MATI=1

# Alamat E-Logbook untuk DIBUKA DI PERAMBAN lewat tombol "Buka E-Logbook".
# Kosongkan saja kalau E-Logbook jalan di mesin yang sama dengan dashboard ini:
# halaman merangkainya sendiri dari hostname yang sedang dipakai + port di atas.
# Isi hanya kalau alamatnya memang lain, mis. sudah di balik nama domain.
#
# Di Vercel WAJIB diisi, dan ini sering terlewat karena kelihatannya kembar
# dengan ELOGBOOK_ASAL. Sebabnya: new URL(ASAL).port pada alamat https bernilai
# kosong lalu jatuh ke 80, jadi tanpa ini tombolnya menunjuk port yang salah.
# ELOGBOOK_TAUTAN=http://elogbook.jatsc.lan

# Set 0 supaya halaman TIDAK jatuh ke data contoh waktu E-Logbook diam.
# Pasang 0 di mana pun yang dipakai orang sungguhan: di sana server yang tidak
# terjawab adalah kerusakan yang pantas terlihat, bukan alasan menampilkan
# angka karangan yang bisa disangka nyata.
# DATA_CONTOH=0

# ---------------------------------------------------------------------------
# SIMPANAN — BERKAS ATAU TABEL
#
# Tanpa AVENGER_DB, seluruh simpanan modul Avenger memakai berkas: data/*.json
# dan public/foto/. Itu yang benar di server kantor.
#
# Di Vercel berkas bersifat baca-saja DAN data/ diabaikan .gitignore, jadi tanpa
# AVENGER_DB=postgres aplikasinya tetap menjawab 200 di semua halaman dengan isi
# KOSONG — dan tidak ada pesan salah yang menjelaskan kenapa. Periksa /_info:
# ia menyebut "simpanan": "tabel" atau "berkas".
# ---------------------------------------------------------------------------

# Nyalakan jalur tabel. Harus persis "postgres", huruf kecil semua.
# AVENGER_DB=postgres

# Connection string Supabase. WAJIB kalau AVENGER_DB=postgres — tanpa itu
# aplikasinya sengaja gagal start, karena jatuh diam-diam ke berkas baca-saja
# jauh lebih buruk daripada gagal terang-terangan.
# Pakai transaction pooler (port 6543), bukan koneksi langsung 5432: Vercel
# menyalakan banyak wadah kecil dan koneksi langsung akan kehabisan jatah.
# DATABASE_URL=

# Untuk foto, logo, dan dokumen di Supabase Storage.
# SUPABASE_SERVICE_KEY memberi akses penuh ke seluruh database dan melewati
# semua aturan — JANGAN pernah masuk repositori ini, yang publik.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_KEY=

# Nama bucket Avenger. Terpisah dari bucket milik E-Logbook.
# AVENGER_BUCKET=avenger

# Ukuran kolam koneksi. Bawaannya 4 di serverless, 5 di server yang hidup terus.
# PGPOOL_MAX=

# Set 1 untuk mematikan unggah dan hapus foto galeri.
# Galeri juga mati sendiri kalau simpanannya memang tidak bisa ditulis — di
# jalur berkas berarti serverless, di jalur tabel berarti SUPABASE_URL atau
# SUPABASE_SERVICE_KEY belum diisi. Yang ini untuk mematikannya dengan sengaja.
# GALERI_MATI=1
