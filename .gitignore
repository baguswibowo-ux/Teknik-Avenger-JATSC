node_modules/
.env
*.log
uploads/
data/
.DS_Store
Thumbs.db

# setelan lokal Claude Code, bukan bagian proyek
.claude/

# Jejak Supabase CLI: berisi ref proyek yang hidup, id organisasi, dan alamat
# pooler lengkap dengan nama pengguna basis data. Repositori ini publik.
**/supabase/.temp/

# Galeri foto: wajah pegawai di ruang terbatas, dan repositori ini publik.
# Fotonya tinggal di komputer masing-masing; hasil clone datang dengan galeri
# kosong dan daftar.json dibuat sendiri oleh server saat foto pertama diunggah.
public/foto/*/
public/foto/daftar.json

.vercel
.env*

# Artefak alat uji lokal — screenshot debug, log browser Playwright, dsb.
# Tidak pernah bagian dari proyek; muncul karena sesi ngoprek.
.playwright-mcp/
*.png
!public/**/*.png
!elogbook/public/**/*.png

# Salinan aset statis E-Logbook, dibuat tools/salin-statis-logbook.js saat build Vercel
public/logbook/

# Cadangan data lokal yang dibuat tools/tarik-supabase.js sebelum menimpa
_cadangan-lokal-*/

# Cadangan harian buatan tools/cadangkan.js (bawaan CADANGAN_DIR) dan log
# server dari tools/server.cmd
cadangan/
server.log

# Salinan dokumen yang dibuat alat bantu, bukan bagian proyek
Claude outputs/
