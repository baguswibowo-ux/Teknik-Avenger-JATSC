# Salin berkas ini menjadi ".env" kalau perlu mengubah bawaannya.
# Berkas .env TIDAK ikut masuk git — isinya bisa rahasia.
#
# Tanpa .env sama sekali, aplikasi tetap jalan memakai SQLite
# (data/elogbook.db) dan folder uploads/ seperti biasa.

# ---------- Kalau diakses lewat HTTPS ----------
# Wajib 1 begitu diakses lewat domain HTTPS, supaya cookie sesi hanya dikirim
# lewat koneksi terenkripsi.
# ELOGBOOK_SECURE_COOKIE=1

# ---------- Satu kali masuk untuk dua aplikasi ----------
# CARA YANG DIPAKAI SEKARANG: pintu tunggal, bukan cookie berdomain induk.
#
# Seluruh E-Logbook disajikan lewat dashboard di /logbook/, jadi bagi peramban
# cuma ada satu asal dan satu sesi — peran dan unit yang berlaku di dashboard
# adalah yang berlaku di sini, tanpa perlu disamakan siapa pun. Isi baris di
# bawah dengan alamat pintu itu; permintaan halaman yang datang langsung ke
# alamat aplikasi ini akan dipantulkan ke sana.
#
# Kosongkan di komputer sendiri: di sana kedua aplikasi memang dibuka masing-
# masing, dan tidak ada yang perlu dipantulkan.
# ELOGBOOK_PINTU=https://teknik-avengers.com/logbook/

# ---------- Cookie berdomain induk ----------
# Domain INDUK cookie sesi. Baru berguna kalau kedua aplikasi sungguh berada
# di dua subdomain dari satu domain sendiri, mis. logbook.avenger-teknik.com
# dan app.avenger-teknik.com. Sesudah itu ia jadi pilihan lain untuk masalah
# yang sama, dan boleh menggantikan pintu tunggal — bukan tambahan untuknya.
#
# Nilainya domain induk, BUKAN subdomain aplikasi ini. Kalau salah, peramban
# membuang cookienya tanpa bersuara: login kelihatan berhasil, permintaan
# berikutnya dijawab 401, dan tidak ada galat di mana pun.
# ELOGBOOK_COOKIE_DOMAIN=avenger-teknik.com

# ---------- Tombol pulang ke Dashboard Fasilitas Teknik ----------
# Wajib begitu aplikasi ini tidak lagi berjalan di port sebelah dashboard.
# Tanpa ini layar menebak port 3100 di hostname yang sedang dipakai. Kalau
# dibiarkan kosong di alamat publik, tombolnya disembunyikan supaya tidak ada
# tautan yang dipencet lalu diam.
# AVENGER_TAUTAN=https://teknik-avengers.com
