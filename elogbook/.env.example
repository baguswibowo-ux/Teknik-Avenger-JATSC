# Salin berkas ini menjadi ".env" lalu isi nilainya.
# Berkas .env TIDAK ikut masuk git — isinya rahasia.
#
# Tanpa .env sama sekali, aplikasi tetap jalan memakai SQLite seperti biasa.
# Isi berkas ini hanya kalau ingin memakai Supabase.

# ---------- Pilih lapisan data ----------
# postgres = Supabase.  Kosongkan atau hapus barisnya untuk kembali ke SQLite.
ELOGBOOK_DB=postgres

# ---------- Supabase: database ----------
# Ambil dari Supabase → Project Settings → Database → Connection string → URI.
# Pakai yang "Session pooler" atau "Transaction pooler" (port 6543) kalau nanti
# dipasang di Vercel, karena serverless membuka banyak koneksi pendek.
# Ganti [YOUR-PASSWORD] dengan password database yang Anda set saat membuat proyek.
DATABASE_URL=postgresql://postgres.[REF-PROYEK]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ---------- Supabase: penyimpanan berkas ----------
# Tanda tangan dan lampiran scan disimpan di sini, bukan di folder uploads/.
SUPABASE_URL=https://[REF-PROYEK].supabase.co

# Project Settings → API Keys → service_role (secret).
# JANGAN pernah menaruh kunci ini di kode frontend atau membagikannya.
SUPABASE_SERVICE_KEY=

# Nama bucket. Sudah dibuat dan bersifat privat.
ELOGBOOK_BUCKET=elogbook

# ---------- Kalau diakses lewat HTTPS ----------
# Wajib 1 di Vercel, supaya cookie sesi hanya dikirim lewat koneksi terenkripsi.
# ELOGBOOK_SECURE_COOKIE=1

# ---------- Satu kali masuk untuk dua aplikasi ----------
# Domain INDUK cookie sesi. Kosongkan selama aplikasi ini dan dashboard masih
# di dua alamat yang tidak bersaudara (mis. keduanya *.vercel.app) — di sana
# cookienya memang harus terikat pada hostnya masing-masing.
#
# Isi begitu keduanya berada di bawah satu domain induk, mis.
# logbook.avenger-teknik.com dan app.avenger-teknik.com. Tanpa ini, masuk lewat
# dashboard tidak membuat sesi di sini: yang menekan "Buka E-Logbook" mendarat
# sebagai siapa pun yang terakhir login LANGSUNG di peramban itu, dan catatan
# yang ia isi tercatat atas nama orang tersebut.
#
# Nilainya domain induk, BUKAN subdomain aplikasi ini. Kalau salah, peramban
# membuang cookienya tanpa bersuara: login kelihatan berhasil, permintaan
# berikutnya dijawab 401, dan tidak ada galat di mana pun.
# ELOGBOOK_COOKIE_DOMAIN=avenger-teknik.com

# ---------- Tombol pulang ke Dashboard Fasilitas Teknik ----------
# Wajib begitu aplikasi ini tidak lagi berjalan di port sebelah dashboard —
# di Vercel, misalnya. Tanpa ini layar menebak port 3100 di hostname yang
# sedang dipakai: benar di kantor, tidak ada di Vercel. Kalau dibiarkan
# kosong di alamat publik, tombolnya disembunyikan supaya tidak ada tautan
# yang dipencet lalu diam.
# AVENGER_TAUTAN=https://teknik-avenger-jatsc.vercel.app
